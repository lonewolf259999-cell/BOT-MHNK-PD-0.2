# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# บอทจะตรวจค่าทั้งหมดตอนสตาร์ท ถ้าผิดจะไม่ยอมรันและบอกว่าผิดตัวไหน

# --- จำเป็น ---
BOT_TOKEN=
CLIENT_ID=            # Discord ID: ตัวเลขล้วน 17-20 หลัก
GUILD_ID=             # Discord ID: ตัวเลขล้วน 17-20 หลัก

# กุญแจ Google Service Account — วางไฟล์ JSON ทั้งก้อนเป็นบรรทัดเดียว
# แบบนี้ย้ายโฮสต์ง่าย ไม่ต้องอัปโหลดไฟล์แยก แก้ที่ .env ที่เดียวจบ
# (ถ้าไม่ใส่ตัวนี้ บอทจะไปหาไฟล์ credentials.json ที่โฟลเดอร์โปรเจกต์แทน)
GOOGLE_JSON_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com", ... }

# --- ไม่ใส่ก็ได้ (มีค่า default) ---
PORT=3000                       # 1-65535 ต้องเป็นตัวเลขล้วน
RENDER_EXTERNAL_URL=            # URL ของบอทบนโฮสต์ ใช้ self-ping กันหลับ (ต้องขึ้นต้น http:// หรือ https://)
LOG_TO_FILE=true                # บนโฮสต์แนะนำ false แล้วให้แพลตฟอร์มเก็บ log จาก stdout แทน

# รหัสผ่านของช่อง GET /logs ที่หน้าเว็บใช้มาขอ log ย้อนหลัง 24 ชั่วโมง
# ตั้งเป็นข้อความสุ่มยาว ๆ (เช่น 32 ตัวอักษรขึ้นไป) แล้วใส่ค่าเดียวกันที่ฝั่งเว็บ
# ไม่ใส่ = ปิดช่องนี้ไปเลย ซึ่งปลอดภัยกว่าเปิดทิ้งไว้
# log มีรหัส Discord ของกำลังพลอยู่ด้วย จึงไม่ใช่ของที่เปิดให้ใครก็ขอได้
LOG_API_TOKEN=
